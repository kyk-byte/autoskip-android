    <string name="status_paused">AutoSkip приостановлен</string>
    <string name="status_paused_description">Доступ выдан. Включите главный переключатель для продолжения.</string>
    <string name="status_active">AutoSkip активен</string>
    <string name="status_active_description">Проверяет выбранные приложения YouTube на безопасную кнопку пропуска.</string>
