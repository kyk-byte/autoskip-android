    <string name="app_name">AutoSkip</string>
    <string name="accessibility_service_label">AutoSkip для YouTube</string>
    <string name="accessibility_service_description">Нажимает доступные кнопки пропуска в YouTube. При отдельном включении пролистывает TikTok только после обнаружения точной рекламной метки. Без доступа к сети и аккаунту.</string>
    <string name="accessibility_service_summary">Пропускает уверенно распознанную рекламу в выбранных приложениях</string>

